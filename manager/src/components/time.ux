<template>
  <div class="time-banner" onclick="handleActivate">
    <div class="time-content">
      <text if="{{flat}}" class="flat-time">{{clock}}</text>
      <text if="{{!flat}}" class="time" style="left:60.9px;top:3.8px;transform: rotate(-21deg)">{{time[0]}}</text>
      <text if="{{!flat}}" class="time" style="left:79px;top:-1px;transform: rotate(-9deg)">{{time[1]}}</text>
      <text if="{{!flat}}" class="time" style="left:93.5px;top:-5px">:</text>
      <text if="{{!flat}}" class="time" style="left:108px;top:-1px;transform: rotate(9deg)">{{time[2]}}</text>
      <text if="{{!flat}}" class="time" style="left:126.1px;top:3.8px;transform: rotate(21deg)">{{time[3]}}</text>
      <text class="pagetitle">{{title}}</text>
    </div>
    <div class="wide-bar {{flat ? 'wide-bar-flat' : ''}}">
      <text class="wide-bar__text">{{title}}</text>
      <text class="wide-bar__time">{{clock}}</text>
    </div>
  </div>
</template>

<style>
.time-banner {
  position: relative;
  display: flex;
  justify-content: center;
  width: 100%;
  height: 77px;
}

.time-content {
  position: relative;
  width: 212px;
  height: 77px;
}

.time {
  position: absolute;
  width: 25px;
  height: 33px;
  font-size: 25px;
  font-weight: 600;
  line-height: normal;
  text-align: center;
  display: flex;
  align-items: flex-end;
  letter-spacing: normal;
  color: rgba(255, 255, 255, 0.6);
  transform-origin: 12.5px 16.5px;
}

.flat-time {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 212px;
  height: 30px;
  font-size: 22px;
  font-weight: 600;
  line-height: 30px;
  text-align: center;
  color: #ffffff;
}

.pagetitle {
  position: absolute;
  left: 0px;
  top: 35px;
  width: 212px;
  height: 42px;
  font-size: 32px;
  font-weight: 600;
  line-height: normal;
  text-align: center;
  letter-spacing: normal;
  color: rgba(255, 255, 255, 1);
}

.wide-bar {
  display: none;
}

/* 小米手环 9/10 Pro：336×480，水平 dp 160。 */
@media (width: 160) {
  .time-content {
    display: none;
  }

  .time-banner {
    height: 60px;
    justify-content: flex-start;
    align-items: center;
  }

  .wide-bar {
    display: flex;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding-top: 14px;
    padding-right: 16px;
    padding-bottom: 14px;
    padding-left: 14px;
  }

  .wide-bar-flat {
    padding-left: 12px;
    padding-right: 12px;
  }

  .wide-bar__text {
    height: 32px;
    font-size: 32px;
    line-height: 32px;
    color: #ffffff;
  }

  .wide-bar__time {
    height: 32px;
    font-size: 32px;
    line-height: 32px;
    color: #ffffff;
    text-align: right;
  }
}
</style>

<script>
export default {
  props: ["title", "clickable", "flat"],

  private: {
    time: "0000",
    clock: "00:00",
    timer: null
  },

  onInit() {
    this.updateTime()
    this.timer = setInterval(() => this.updateTime(), 1000)
  },

  onDestroy() {
    if (this.timer !== null) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  handleActivate() {
    if (this.clickable) this.$emit("activate")
  },

  updateTime() {
    const now = new Date()
    const hours = now.getHours().toString().padStart(2, "0")
    const minutes = now.getMinutes().toString().padStart(2, "0")
    this.time = `${hours}${minutes}`
    this.clock = `${hours}:${minutes}`
  }
}
</script>
