<script>
import router from "@system.router"
import { InterconnectThemeReceiver } from "./ts/interconnect"

export default {
  onCreate() {
    globalThis.receivePageVisible = false
    const receiver = new InterconnectThemeReceiver(() => {
      if (!globalThis.receivePageVisible) router.push({ uri: "pages/receive" })
    })
    globalThis.themeReceiver = receiver
    receiver.start()
  },
  onDestroy() {
    if (globalThis.themeReceiver) {
      globalThis.themeReceiver.stop()
      globalThis.themeReceiver = null
    }
  }
}
</script>
