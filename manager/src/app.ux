<script>
import router from "@system.router"
import { InterconnectThemeReceiver } from "./ts/interconnect"
import * as file from "./ts/file"
import { initializeResourceCatalogSession, destroyResourceCatalogSession } from "./ts/resource-overrides"
import { initializeModuleControlSession, destroyModuleControlSession } from "./ts/module-control"

export default {
  onCreate() {
    initializeResourceCatalogSession(file)
    initializeModuleControlSession()
    globalThis.receivePageVisible = false
    const receiver = new InterconnectThemeReceiver(() => {
      if (!globalThis.receivePageVisible) router.push({ uri: "pages/receive" })
    })
    globalThis.themeReceiver = receiver
    receiver.start()
  },
  onDestroy() {
    if (globalThis.themeReceiver) {
      globalThis.themeReceiver.stop()
      globalThis.themeReceiver = null
    }
    destroyModuleControlSession()
    destroyResourceCatalogSession()
  }
}
</script>
