<import name="time-banner" src="../../components/time"></import>

<template>
  <div class="page" ontouchstart="preserveForUser">
    <div class="header">
      <time-banner title="{{headerTitle}}" clickable="true" onactivate="goBack" />
    </div>

    <text if="{{statusText}}" class="status">{{statusText}}</text>
    <scroll if="{{loaded && rows.length}}" id="resource-path-list" class="resource-list"
      scroll-y="true" scroll-x="false" bounces="false">
      <div for="{{row in rows}}" tid="sourcePath" class="resource-row"
        onclick="openPath(row.sourcePath)">
        <div class="resource-item">
          <div class="resource-copy">
            <text class="resource-path">{{row.sourcePath}}</text>
            <text class="resource-choice">{{row.choiceName}}</text>
          </div>
        </div>
      </div>
      <div class="bottom-spacer"></div>
    </scroll>
    <img if="{{loaded && !rows.length}}" class="empty-img" src="/common/images/none.png"/>
  </div>
</template>

<script>
import router from "@system.router"
import * as file from "../../ts/file"
import {
  DEFAULT_RESOURCE_CHOICE,
  getResourceCatalog,
  isResourceCatalogCurrent,
  loadResourceOverrides,
  resolveResourceChoice,
  validSourcePath,
  SYSTEM_RESOURCE_CHOICE
} from "../../ts/resource-overrides"

export default {
  private: {
    headerTitle: "< 混搭微调",
    rows: [],
    pathRows: [],
    statusText: "正在读取替换资源…",
    loaded: false,
    visible: false,
    loadVersion: 0,
    catalogRevision: -1
  },

  onInit() {
    if (globalThis.themeReceiver) globalThis.themeReceiver.captureLaunchContext()
  },

  preserveForUser() {
    if (globalThis.themeReceiver) globalThis.themeReceiver.preserveForUser()
  },

  onShow() {
    this.visible = true
    this.loadCatalog()
  },

  onHide() {
    this.visible = false
    this.loadVersion += 1
  },

  onDestroy() {
    this.visible = false
    this.loadVersion += 1
  },

  async loadCatalog() {
    const version = ++this.loadVersion
    if (!this.loaded) this.statusText = "正在读取替换资源…"
    try {
      const [catalog, overrides] = await Promise.all([
        getResourceCatalog(file),
        loadResourceOverrides(file)
      ])
      if (version !== this.loadVersion || !this.visible) return
      if (!isResourceCatalogCurrent(catalog)) return this.loadCatalog()
      const choiceName = (item, choice) => {
        if (choice === DEFAULT_RESOURCE_CHOICE) return "默认"
        if (choice === SYSTEM_RESOURCE_CHOICE) return "系统"
        const selectedTheme = item.themes.find(theme => theme.themeId === choice)
        return selectedTheme ? selectedTheme.name : "默认"
      }
      let reorder = false
      if (this.loaded && this.catalogRevision === catalog.revision) {
        // Update retained rows without allocating replacements on return.
        this.pathRows.forEach(row => {
          const item = catalog.byPath.get(row.sourcePath)
          const choice = resolveResourceChoice(item, overrides)
          if (row.choiceId === choice) return
          if ((row.choiceId === DEFAULT_RESOURCE_CHOICE) !== (choice === DEFAULT_RESOURCE_CHOICE))
            reorder = true
          row.choiceId = choice
          row.choiceName = choiceName(item, choice)
        })
      } else {
        // Cache the original path order; regrouping the displayed order would lose it.
        this.pathRows = catalog.paths.map(item => {
          const choice = resolveResourceChoice(item, overrides)
          return { sourcePath: item.sourcePath, choiceId: choice, choiceName: choiceName(item, choice) }
        }).sort((left, right) => left.sourcePath.localeCompare(right.sourcePath))
        reorder = true
      }
      if (reorder) this.orderRows()
      this.catalogRevision = catalog.revision
      this.loaded = true
      this.statusText = ""
    } catch (error) {
      if (version !== this.loadVersion || !this.visible) return
      this.rows = []
      this.pathRows = []
      this.loaded = false
      this.statusText = String(error && error.message || "读取混搭资源失败")
    }
  },

  orderRows() {
    // Stable partition in O(n), reusing row objects and avoiding path comparisons.
    const customized = []
    const defaults = []
    this.pathRows.forEach(row => {
      if (row.choiceId === DEFAULT_RESOURCE_CHOICE) defaults.push(row)
      else customized.push(row)
    })
    const rows = customized.concat(defaults)
    // A grouping change need not change positions; keep the array when it does not.
    if (rows.length !== this.rows.length || rows.some((row, index) => row !== this.rows[index]))
      this.rows = rows
  },

  openPath(sourcePath) {
    if (!validSourcePath(sourcePath)) return
    router.push({ uri: "pages/mix-match-select", params: { sourcePath } })
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.header {
  position: absolute;
  left: 0;
  top: 0px;
  width: 100%;
  height: 77px;
  flex-direction: column;
  align-items: center;
}

.resource-list {
  position: absolute;
  left: 0;
  top: 96px;
  width: 100%;
  height: 372px;
  padding-left: 3px;
  padding-right: 3px;
  flex-direction: column;
}

.resource-row {
  width: 206px;
  flex-shrink: 0;
}

.resource-item {
  width: 206px;
  height: auto;
  margin-bottom: 8px;
  padding: 10px 14px;
  border-radius: 28px;
  background-color: #262626;
  align-items: center;
}

.resource-copy {
  width: 172px;
  flex-direction: column;
  justify-content: center;
}

.resource-path {
  width: 172px;
  color: #FFFFFF;
  font-size: 28px;
  font-weight: normal;
  lines: 0;
  text-overflow: ellipsis;
}

.resource-choice {
  width: 172px;
  margin-top: 3px;
  color: rgba(255, 255, 255, 0.60);
  font-size: 18px;
  line-height: 22px;
  lines: 1;
  text-overflow: ellipsis;
}

.status {
  position: absolute;
  left: 14px;
  top: 218px;
  width: 180px;
  color: #BBBBBB;
  font-size: 15px;
  line-height: 21px;
  text-align: center;
  lines: 4;
  text-overflow: ellipsis;
}

.empty-img {
  flex-shrink: 0;
  object-fit: contain;
}

.bottom-spacer {
  display: none;
}

/* 212x520 template: use aspect ratio because media-query widths are in dp. */
@media (aspect-ratio: 53/130) {
  .resource-list {
    height: 424px;
  }

  .bottom-spacer {
    display: flex;
    width: 100%;
    height: 52px;
    flex-shrink: 0;
  }
}

@media (width >= 160) {
  .header {
    top: 0px;
    height: 60px;
  }

  .resource-list {
    top: 60px;
    height: 408px;
    padding-left: 6px;
    padding-right: 6px;
  }

  .resource-row,
  .resource-item {
    width: 100%;
  }

  .resource-item {
    padding: 14px 20px;
    border-radius: 32px;
  }

  .resource-copy,
  .resource-path,
  .resource-choice {
    width: 100%;
  }

  .status {
    left: 0px;
    width: 100%;
  }
}
</style>
