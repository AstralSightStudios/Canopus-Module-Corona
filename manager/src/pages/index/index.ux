<template>
  <div class="page">
    <text class="title">设置图标主题测试</text>
    <text class="hint">安装或删除后，点“重载资源”应用；模块约每秒检查一次。</text>

    <div class="actions">
      <input class="button install-button" type="button" value="安装测试" disabled="{{busy}}" onclick="installTestTheme" />
      <input class="button delete-button" type="button" value="删除主题" disabled="{{busy}}" onclick="deleteTestTheme" />
      <input class="button reload-button" type="button" value="重载资源" disabled="{{busy}}" onclick="requestReload" />
    </div>

    <text class="status">{{ statusText }}</text>
    <text class="footnote">Manager 只能写入重载信号，无法确认模块是否已应用。</text>
  </div>
</template>

<script>
import file from "@system.file"
import { ThemeBridge } from "../../ts/theme-bridge"

export default {
  private: {
    busy: false,
    statusText: "准备就绪：安装或删除后，请点“重载资源”。",
    bridge: null
  },

  onInit() {
    this.bridge = new ThemeBridge(file)
  },

  installTestTheme() {
    this.runOperation(
      "正在安装设置图标主题…",
      () => this.bridge.installTestTheme(),
      "测试主题已写入；现在点“重载资源”应用。"
    )
  },

  deleteTestTheme() {
    this.runOperation(
      "正在删除设置图标主题…",
      () => this.bridge.deleteTestTheme(),
      "测试主题映射已移除；点“重载资源”恢复原始资源。"
    )
  },

  requestReload() {
    this.runOperation(
      "正在写入重载信号…",
      () => this.bridge.requestReload(),
      revision => `重载信号 ${revision} 已写入；模块会在轮询时读取。`
    )
  },

  runOperation(startText, operation, successText) {
    if (this.busy) return
    this.busy = true
    this.statusText = startText
    Promise.resolve().then(operation).then(result => {
      this.statusText = typeof successText === "function" ? successText(result) : successText
    }).catch(error => {
      this.statusText = `操作失败：${String(error)}`
    }).then(() => {
      this.busy = false
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 10px;
  box-sizing: border-box;
}

.title {
  font-size: 17px;
  font-weight: bold;
  margin-bottom: 4px;
}

.hint, .footnote {
  font-size: 11px;
  color: #526078;
}

.hint {
  margin-bottom: 8px;
}

.actions {
  flex-direction: row;
  width: 100%;
  height: 38px;
}

.button {
  flex: 1;
  height: 36px;
  margin-left: 4px;
  padding-left: 0;
  padding-right: 0;
  border-radius: 7px;
  font-size: 11px;
}

.install-button {
  margin-left: 0;
  color: #FFFFFF;
  background-color: #2456B8;
}

.delete-button {
  color: #8A2424;
  background-color: #FBE9E9;
}

.reload-button {
  color: #24344D;
  background-color: #E7EDF5;
}

.status {
  margin-top: 8px;
  font-size: 11px;
  color: #17243A;
}

.footnote {
  margin-top: 4px;
}
</style>
