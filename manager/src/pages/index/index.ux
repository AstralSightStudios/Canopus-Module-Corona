<import name="time-banner" src="../../components/time"></import>

<template>
  <div class="page" ontouchstart="preserveForUser">
    <div class="time-section">
      <time-banner title="Corona" flat="true" />
    </div>

    <list class="card-list">
      <list-item type="module-status" class="status-item">
        <div class="module-status {{moduleState}}">
          <div if="{{moduleIcon}}" class="module-status-icon-wrap">
            <img class="module-status-icon" src="{{moduleIcon}}" />
          </div>
          <div class="module-status-copy">
            <text class="module-status-title">{{moduleTitle}}</text>
            <text class="module-status-description {{moduleState}}-description">{{moduleDescription}}</text>
          </div>
        </div>
      </list-item>
      <list-item type="item" class="item" onclick="openResources">
        <text class="itemtext">资源管理</text>
        <img class="enter" src="/common/images/enter.png" />
      </list-item>
      <!-- Different outer spacing requires an independent list-item template. -->
      <list-item type="item-last" class="item item-last" onclick="openMixMatch">
        <text class="itemtext">混搭微调</text>
        <img class="enter" src="/common/images/enter.png" />
      </list-item>
    </list>
    <div class="reload-action-wrap">
      <img class="reload-action" style="opacity: {{sendingReload ? 0.4 : 1}};"
        src="/common/images/reload.png" onclick="requestReload" />
      <img class="reload-action-wide" style="opacity: {{sendingReload ? 0.4 : 1}};"
        src="/common/images/reload-wide.png" onclick="requestReload" />
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import * as file from "../../ts/file"
import router from "@system.router"
import {
  getInitialModuleStatus, sendReloadSignal, waitForReloadOutcome, withModuleControlOperation
} from "../../ts/module-control"
import { cleanupInactiveGenerations, regenerateActiveMappings } from "../../ts/resource-activation"
import { loadResourceOrder } from "../../ts/resource-order"
import { getResourceCatalog, getResourceFileApi, reconcileResourceOverrides, withResourceOperation } from "../../ts/resource-overrides"

export default {
  // HAP query parameters are injected into public properties, not private state.
  public: {
    astroboxCheckToken: ""
  },
  private: {
    sendingReload: false,
    reloadRevision: 0,
    pageActive: true,
    statusReadRevision: 0,
    moduleState: "checking",
    moduleTitle: "正在检测",
    moduleDescription: "请稍候",
    moduleIcon: ""
  },

  onInit() {
    // onInit can run on re-entry too; only the app-owned one-shot gate may bind.
    if (globalThis.themeReceiver) globalThis.themeReceiver.captureLaunchContext(this.astroboxCheckToken)
    this.pageActive = true
    return this.loadModuleStatus()
  },

  onShow() {
    this.pageActive = true
    // The app-session cache reuses the first query and any newer reload snapshot.
    return this.loadModuleStatus()
  },

  onRefresh() {
    this.preserveForUser()
  },

  onHide() {
    this.pageActive = false
    this.statusReadRevision++
  },

  onDestroy() {
    this.pageActive = false
    this.statusReadRevision++
  },

  async loadModuleStatus() {
    const revision = ++this.statusReadRevision
    try {
      const outcome = await getInitialModuleStatus(getResourceFileApi(file))
      if (this.pageActive && revision === this.statusReadRevision)
        this.applyModuleOutcome(outcome)
    } catch (_error) {
      if (this.pageActive && revision === this.statusReadRevision)
        this.applyModuleOutcome({ status: null, reason: "read_error" })
    }
  },

  applyModuleOutcome(outcome) {
    if (!this.pageActive || !outcome) return
    const status = outcome.status
    if (status) {
      if (status.state === "config_error") {
        this.moduleState = "config_error"
        this.moduleTitle = "配置错误"
        this.moduleDescription = "模块已安装"
        this.moduleIcon = "/common/images/status-config-error.png"
      } else {
        this.moduleState = "running"
        this.moduleTitle = "正在工作"
        this.moduleDescription = `已加载${status.activeRuleCount}条规则`
        this.moduleIcon = "/common/images/status-running.png"
      }
    } else if (outcome.reason === "timeout") {
      this.moduleState = "unresponsive"
      this.moduleTitle = "模块异常"
      this.moduleDescription = "未检测到模块"
      this.moduleIcon = "/common/images/status-unresponsive.png"
    } else if (outcome.reason !== "cancelled" &&
               (this.moduleState === "checking" || this.moduleState === "unavailable")) {
      // File I/O failure cannot prove the resident module is absent.
      this.moduleState = "unavailable"
      this.moduleTitle = "检测失败"
      this.moduleDescription = "请稍后重载"
      this.moduleIcon = ""
    }
  },

  preserveForUser() {
    if (globalThis.themeReceiver) globalThis.themeReceiver.preserveForUser()
  },

  openResources() {
    this.preserveForUser()
    router.push({ uri: "pages/resources" })
  },

  openMixMatch() {
    this.preserveForUser()
    router.push({ uri: "pages/mix-match" })
  },

  async requestReload() {
    this.preserveForUser()
    if (this.sendingReload) return
    this.sendingReload = true
    this.reloadRevision = Math.max(Date.now(), this.reloadRevision + 1)
    try {
      await withResourceOperation(() => this.performReload())
    } finally {
      this.sendingReload = false
    }
  },

  async performReload() {
    let mappingsGenerated = false
    let signalSent = false
    try {
      const revision = `${this.reloadRevision}-${Math.floor(Math.random() * 1000000).toString(36)}`
      const reloadFile = getResourceFileApi(file)
      // Receiver writes and deletion invalidate this app-owned snapshot.
      const snapshot = await getResourceCatalog(reloadFile)
      const order = await loadResourceOrder(snapshot.installedThemeIds, reloadFile)
      const overrides = await reconcileResourceOverrides(snapshot.paths, reloadFile)
      const plan = await regenerateActiveMappings(order, revision, reloadFile, overrides, snapshot)
      mappingsGenerated = true
      const outcome = await withModuleControlOperation(async () => {
        await sendReloadSignal(revision, reloadFile)
        signalSent = true
        return waitForReloadOutcome(revision, reloadFile)
      })
      this.statusReadRevision++
      this.applyModuleOutcome(outcome)
      if (this.pageActive) prompt.showToast({ message: outcome.message })
      if (outcome.successful) {
        try { await cleanupInactiveGenerations(plan.generation, reloadFile, plan.mappings); }
        catch (_cleanupError) { /* Keep unused generations rather than risk the active one. */ }
      }
    } catch (error) {
      let message = "重载失败"
      if (!mappingsGenerated) message = String(error && error.message || "资源映射生成失败")
      else if (!signalSent) message = "重载信号发送失败"
      else message = "等待模块响应失败"
      if (this.pageActive) prompt.showToast({ message })
    }
  },

}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
}

.time-section {
  position: absolute;
  left: 0;
  top: 0px;
  width: 100%;
  height: 77px;
  flex-direction: column;
  align-items: center;
}

.status-item {
  height: 100px;
  margin-bottom: 10px;
}

.module-status {
  position: relative;
  width: 100%;
  height: 100px;
  border-radius: 22px;
  overflow: hidden;
  background-color: #262626;
}

.running {
  background-color: #1da362;
}

.config_error {
  background-color: #df9725;
}

.unresponsive {
  background-color: #da593c;
}

.module-status-copy {
  position: absolute;
  left: 14px;
  top: 14px;
  width: 134px;
  height: 72px;
  flex-direction: column;
}

.module-status-title {
  width: 134px;
  height: 40px;
  line-height: 40px;
  font-size: 30px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
}

.module-status-description {
  width: 134px;
  height: 32px;
  line-height: 32px;
  font-size: 24px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.75);
  lines: 1;
}

/* Approved copy is longer than the four-character Figma examples. */
.running-description {
  font-size: 17px;
}

.unresponsive-description {
  font-size: 21px;
}

.module-status-icon-wrap {
  position: absolute;
  right: -18px;
  bottom: 7px;
  width: 86px;
  height: 86px;
  overflow: visible;
}

/* The supplied 138x145 PNGs include transparent padding and baked shadows.
 * These offsets align the visible artwork with Figma's 86px icon frame. */
.module-status-icon {
  position: absolute;
  right: -3px;
  bottom: -5px;
  width: 92px;
  height: 97px;
  object-fit: contain;
}

.card-list {
  position: absolute;
  left: 0;
  top: 86px;
  width: 100%;
  /* Use the full space above the action, not an exact content-height fit.
   * Spare pixels absorb native layout rounding without changing row positions. */
  height: 294px;
  padding-left: 3px;
  padding-right: 3px;
}

.item {
  height: 83px;
  margin-bottom: 10px;
  background-color: #262626;
  border-radius: 30px;
  align-items: center;
}

.item-last {
  margin-bottom: 0px;
}

.itemtext {
  width: 151px;
  margin-left: 12px;
  color: #FFFFFF;
  font-size: 35px;
  font-weight: bold;
  line-height: 40px;
  text-overflow: ellipsis;
  lines: 1;
}

.enter {
  width: 40px;
  height: 40px;
}

.reload-action-wrap {
  position: absolute;
  left: 0;
  bottom: 10px;
  width: 100%;
  height: 78px;
  align-items: center;
  justify-content: center;
}

.reload-action {
  width: 150px;
  height: 78px;
}

.reload-action-wide {
  display: none;
  width: 324px;
  height: 80px;
}

@media (aspect-ratio: 53/130) {
  .card-list {
    height: 346px;
  }

  .item {
    height: 102px;
  }
}

@media (width: 160) {
  .module-status-copy {
    top: 12px;
    width: 183px;
    height: 76px;
  }

  .module-status-title {
    width: 183px;
    height: 42px;
    line-height: 42px;
    font-size: 32px;
  }

  .module-status-description {
    width: 183px;
    height: 34px;
    line-height: 34px;
    font-size: 26px;
  }

  .running-description {
    font-size: 24px;
  }

  .unresponsive-description {
    font-size: 26px;
  }

  .module-status-icon-wrap {
    right: 6px;
    bottom: -30px;
    width: 128px;
    height: 128px;
  }

  .module-status-icon {
    right: -6px;
    bottom: -8px;
    width: 138px;
    height: 145px;
  }

  .reload-action-wrap {
    height: 80px;
  }

  .reload-action {
    display: none;
  }

  .reload-action-wide {
    display: flex;
  }

  .page {
    flex-direction: row;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .time-section {
    top: 0px;
    height: 60px;
    align-self: flex-start;
  }

  .card-list {
    top: 68px;
    height: 322px;
  }

  .item {
    height: 96px;
    padding-left: 12px;
    padding-right: 12px;
  }

  .itemtext {
    width: 100%;
    margin-left: 0px;
  }

  .enter {
    display: none;
  }
}
</style>
