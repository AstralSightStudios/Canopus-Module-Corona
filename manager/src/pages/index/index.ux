<import name="time-banner" src="../../components/time"></import>

<template>
  <div class="page">
    <div class="time-section">
      <time-banner title="Corona" />
    </div>

    <list class="card-list">
      <list-item type="item" class="item" onclick="openResources">
        <text class="itemtext">资源管理</text>
        <img class="enter" src="/common/images/enter.png" />
      </list-item>
      <list-item type="item" class="item" onclick="noop">
        <text class="itemtext">混搭微调</text>
        <img class="enter" src="/common/images/enter.png" />
      </list-item>
    </list>
    <div class="reload-action-wrap">
      <img class="reload-action" src="/common/images/reload.png" onclick="requestReload" />
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import * as file from "../../ts/file"
import router from "@system.router"
import { sendReloadSignal, waitForReloadOutcome } from "../../ts/reload-signal"
import { cleanupInactiveGenerations, regenerateActiveMappings } from "../../ts/resource-activation"
import { loadResourceOrder, readInstalledThemeIds } from "../../ts/resource-order"

export default {
  private: {
    sendingReload: false,
    reloadRevision: 0
  },

  openResources() {
    router.push({ uri: "pages/resources" })
  },

  async requestReload() {
    if (this.sendingReload) return
    this.sendingReload = true
    this.reloadRevision = Math.max(Date.now(), this.reloadRevision + 1)
    let mappingsGenerated = false
    let signalSent = false
    try {
      const revision = `${this.reloadRevision}-${Math.floor(Math.random() * 1000000).toString(36)}`
      const installedThemeIds = await readInstalledThemeIds(file)
      const order = await loadResourceOrder(installedThemeIds, file)
      const plan = await regenerateActiveMappings(order, revision, file)
      mappingsGenerated = true
      await sendReloadSignal(revision, file)
      signalSent = true
      const outcome = await waitForReloadOutcome(revision, file)
      prompt.showToast({ message: outcome.message })
      if (outcome.successful) {
        try { await cleanupInactiveGenerations(plan.generation, file); }
        catch (_cleanupError) { /* Keep unused generations rather than risk the active one. */ }
      }
    } catch (error) {
      let message = "重载失败"
      if (!mappingsGenerated) message = String(error && error.message || "资源映射生成失败")
      else if (!signalSent) message = "重载信号发送失败"
      else message = "等待模块响应失败"
      prompt.showToast({ message })
    } finally {
      this.sendingReload = false
    }
  },

  noop() {}
}
</script>

