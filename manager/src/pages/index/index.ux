<import name="time-banner" src="../../components/time"></import>

<template>
  <div class="page">
    <div class="time-section">
      <time-banner title="Corona" />
    </div>

    <list class="card-list">
      <list-item type="item" class="item" onclick="openResources">
        <text class="itemtext">资源管理</text>
        <img class="enter" src="/common/images/enter.png" />
      </list-item>
      <list-item type="item" class="item" onclick="openMixMatch">
        <text class="itemtext">混搭微调</text>
        <img class="enter" src="/common/images/enter.png" />
      </list-item>
    </list>
    <div class="reload-action-wrap">
      <img class="reload-action" style="opacity: {{sendingReload ? 0.4 : 1}};"
        src="/common/images/reload.png" onclick="requestReload" />
    </div>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import * as file from "../../ts/file"
import router from "@system.router"
import { sendReloadSignal, waitForReloadOutcome } from "../../ts/reload-signal"
import { cleanupInactiveGenerations, regenerateActiveMappings } from "../../ts/resource-activation"
import { loadResourceOrder, readInstalledThemeIds } from "../../ts/resource-order"
import { getResourceFileApi, invalidateResourceCatalog, loadResourcePackSnapshot, reconcileResourceOverrides, withResourceOperation } from "../../ts/resource-overrides"

export default {
  private: {
    sendingReload: false,
    reloadRevision: 0
  },

  openResources() {
    router.push({ uri: "pages/resources" })
  },

  openMixMatch() {
    router.push({ uri: "pages/mix-match" })
  },

  async requestReload() {
    if (this.sendingReload) return
    this.sendingReload = true
    this.reloadRevision = Math.max(Date.now(), this.reloadRevision + 1)
    try {
      await withResourceOperation(() => this.performReload())
    } finally {
      this.sendingReload = false
    }
  },

  async performReload() {
    let mappingsGenerated = false
    let signalSent = false
    try {
      const revision = `${this.reloadRevision}-${Math.floor(Math.random() * 1000000).toString(36)}`
      const reloadFile = getResourceFileApi(file)
      // Reload is authoritative, including files changed outside the current page session.
      invalidateResourceCatalog()
      const installedThemeIds = await readInstalledThemeIds(reloadFile)
      const [order, snapshot] = await Promise.all([
        loadResourceOrder(installedThemeIds, reloadFile),
        loadResourcePackSnapshot(installedThemeIds, reloadFile)
      ])
      const overrides = await reconcileResourceOverrides(snapshot.paths, reloadFile)
      const plan = await regenerateActiveMappings(order, revision, reloadFile, overrides, snapshot)
      mappingsGenerated = true
      await sendReloadSignal(revision, reloadFile)
      signalSent = true
      const outcome = await waitForReloadOutcome(revision, reloadFile)
      prompt.showToast({ message: outcome.message })
      if (outcome.successful) {
        try { await cleanupInactiveGenerations(plan.generation, reloadFile); }
        catch (_cleanupError) { /* Keep unused generations rather than risk the active one. */ }
      }
    } catch (error) {
      let message = "重载失败"
      if (!mappingsGenerated) message = String(error && error.message || "资源映射生成失败")
      else if (!signalSent) message = "重载信号发送失败"
      else message = "等待模块响应失败"
      prompt.showToast({ message })
    }
  },

}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
}

.time-section {
  position: absolute;
  left: 0;
  top: 12px;
  width: 100%;
  height: 77px;
  flex-direction: column;
  align-items: center;
}

.card-list {
  position: absolute;
  left: 0;
  top: 93px;
  width: 100%;
  height: 427px;
}

.item {
  height: 102px;
  margin-bottom: 9px;
  background-color: #262626;
  border-radius: 30px;
  align-items: center;
}

.itemtext {
  width: 155px;
  margin-left: 12px;
  color: #FFFFFF;
  font-size: 35px;
  font-weight: bold;
  line-height: 40px;
  text-overflow: ellipsis;
  lines: 1;
}

.enter {
  width: 40px;
  height: 40px;
}

.reload-action-wrap {
  position: absolute;
  left: 0;
  bottom: 10px;
  width: 100%;
  height: 78px;
  align-items: center;
  justify-content: center;
}

.reload-action {
  width: 150px;
  height: 78px;
}

@media (width: 160) {
  .page {
    flex-direction: row;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .time-section {
    top: 0px;
    height: 60px;
    align-self: flex-start;
  }

  .card-list {
    top: 60px;
    height: 460px;
  }

  .item {
    padding-left: 12px;
    padding-right: 12px;
  }

  .itemtext {
    width: 100%;
    margin-left: 0px;
  }

  .enter {
    display: none;
  }
}
</style>
