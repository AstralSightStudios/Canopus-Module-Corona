  width: 100%;
  height: 100%;
  background-color: #000000;
  flex-direction: column;
}

.time-section {
  position: absolute;
  left: 0;
  top: 12px;
  width: 100%;
  height: 77px;
  flex-direction: column;
  align-items: center;
}

.card-list {
  position: absolute;
  left: 0;
  top: 93px;
  width: 100%;
  height: 427px;
}

.item {
  height: 102px;
  margin-bottom: 9px;
  background-color: #262626;
  border-radius: 30px;
  align-items: center;
}

.itemtext {
  width: 155px;
  margin-left: 12px;
  color: #FFFFFF;
  font-size: 35px;
  font-weight: bold;
  line-height: 40px;
  text-overflow: ellipsis;
  lines: 1;
}

.enter {
  width: 40px;
  height: 40px;
}

.reload-action-wrap {
  position: absolute;
  left: 0;
  bottom: 10px;
  width: 100%;
  height: 78px;
  align-items: center;
  justify-content: center;
}

.reload-action {
  width: 150px;
  height: 78px;
}
</style>
