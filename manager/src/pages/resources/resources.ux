<import name="time-banner" src="../../components/time"></import>

<template>
  <div class="page">
    <div class="header">
      <time-banner title="{{headerTitle}}" clickable="true" onactivate="goBack" />
    </div>

    <text if="{{themes.length == 0}}" class="empty-state">{{statusText}}</text>
    <list if="{{themes.length > 0}}" class="resource-list">
      <list-item for="{{theme in themes}}" type="resource" class="resource-item">
        <div class="resource-copy">
          <text class="theme-name">{{theme}}</text>
          <text class="theme-meta">已接收资源包</text>
        </div>
      </list-item>
    </list>

  </div>
</template>

<script>
import router from "@system.router"
import * as file from "../../ts/file"

const INSTALLED_THEMES_URI = "internal://files/interconnect-themes.json"
const VALID_THEME_ID = /^[a-z0-9_-]{1,12}$/

export default {
  private: {
    headerTitle: "< 资源管理",
    themes: [],
    statusText: "正在读取资源包…"
  },

  onShow() {
    this.loadThemes()
  },

  async loadThemes() {
    this.statusText = "正在读取资源包…"
    try {
      const text = await file.readOptionalText(INSTALLED_THEMES_URI)
      if (text === null) {
        this.themes = []
        this.statusText = "尚未接收资源包"
        return
      }
      const themes = JSON.parse(text)
      if (!Array.isArray(themes) || themes.some(theme =>
        typeof theme !== "string" || !VALID_THEME_ID.test(theme))) {
        throw new Error("资源包索引格式无效")
      }
      this.themes = themes
      this.statusText = themes.length ? "" : "尚未接收资源包"
    } catch (_error) {
      this.themes = []
      this.statusText = "读取资源包列表失败，请返回后重试。"
    }
  },

  goBack() {
    router.back()
  },

}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.header {
  position: absolute;
  left: 0;
  top: 12px;
  width: 100%;
  height: 77px;
  align-items: center;
}

.resource-list {
  position: absolute;
  left: 0;
  top: 96px;
  width: 100%;
  height: 338px;
  padding-left: 8px;
  padding-right: 8px;
}

.resource-item {
  width: 196px;
  height: 82px;
  margin-bottom: 8px;
  padding-left: 12px;
  border-radius: 24px;
  background-color: #262626;
  align-items: center;
}

.resource-copy {
  width: 172px;
  flex-direction: column;
  justify-content: center;
}

.theme-name {
  width: 172px;
  color: #FFFFFF;
  font-size: 22px;
  font-weight: bold;
  lines: 1;
  text-overflow: ellipsis;
}

.theme-meta {
  width: 172px;
  margin-top: 4px;
  color: #BBBBBB;
  font-size: 15px;
  lines: 1;
}

.empty-state {
  position: absolute;
  left: 16px;
  top: 225px;
  width: 180px;
  color: #BBBBBB;
  font-size: 18px;
  line-height: 26px;
  text-align: center;
  lines: 2;
}

</style>
