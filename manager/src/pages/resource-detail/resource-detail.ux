<import name="time-banner" src="../../components/time"></import>

<template>
  <div class="page" ontouchstart="preserveForUser">
    <div class="header">
      <time-banner title="< 资源详情" clickable="true" onactivate="goBack" />
    </div>

    <text if="{{!loaded}}" class="status">{{statusText}}</text>
    <scroll if="{{loaded}}" class="detail-list" scroll-y="true" scroll-x="false" bounces="false">
      <div class="detail-card">
        <text class="detail-title">主题包</text>
        <text class="detail-value">{{name}}</text>
      </div>
      <div class="detail-card">
        <text class="detail-title">作者</text>
        <text class="detail-value">{{author}}</text>
      </div>
      <div class="detail-card">
        <text class="detail-title">版本</text>
        <text class="detail-value">{{version}}</text>
      </div>
      <div class="detail-card">
        <text class="detail-title">简介</text>
        <text class="detail-value">{{description}}</text>
      </div>
      <div class="detail-card">
        <text class="detail-title">适用设备</text>
        <text class="detail-value">{{targetsLine}}</text>
      </div>
      <div class="detail-card">
        <text class="detail-title">资源包 ID</text>
        <text class="detail-value">{{themeId}}</text>
      </div>
      <div class="detail-bottom-spacer"></div>
    </scroll>
    <div if="{{loaded}}" class="delete-action-wrap">
      <img class="delete-action" src="/common/images/del.png" onclick="onDeleteTap" />
      <img class="delete-action-wide" src="/common/images/del-wide.png" onclick="onDeleteTap" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import * as file from "../../ts/file"
import { readResourcePackManifest } from "../../ts/resource-pack"
import { removeInstalledTheme } from "../../ts/resource-storage"

const THEME_ROOT_URI = "internal://files/themes/"
const VALID_THEME_ID = /^[a-z0-9_-]{1,64}$/

export default {
  private: {
    themeId: "",
    loaded: false,
    statusText: "正在读取资源包…",
    name: "",
    author: "",
    version: "",
    description: "",
    targetsLine: "",
    deleteFirstTapAt: null,
    deleting: false
  },

  onInit() {
    if (globalThis.themeReceiver) globalThis.themeReceiver.captureLaunchContext()
    this.loadManifest()
  },

  preserveForUser() {
    if (globalThis.themeReceiver) globalThis.themeReceiver.preserveForUser()
  },

  async loadManifest() {
    const themeId = this.themeId
    if (typeof themeId !== "string" || !VALID_THEME_ID.test(themeId)) {
      this.statusText = "资源包标识无效。"
      return
    }

    this.statusText = "正在读取资源包…"
    try {
      const manifest = await readResourcePackManifest(`${THEME_ROOT_URI}${themeId}/`, themeId, file)
      if (manifest === null) throw new Error("找不到 corona.json")
      this.name = manifest.name
      this.author = manifest.author || "未声明作者"
      this.version = manifest.version ? `v${manifest.version}` : "未声明版本"
      this.description = manifest.description || "暂无简介"
      this.targetsLine = manifest.targets && manifest.targets.length
        ? manifest.targets.join("、")
        : "未声明目标设备"
      this.loaded = true
      this.statusText = ""
    } catch (error) {
      this.loaded = false
      this.statusText = `无法读取资源包信息：${String(error.message || error)}`
    }
  },

  onDeleteTap() {
    if (this.deleting) return
    const now = Date.now()
    const elapsed = this.deleteFirstTapAt === null ? Infinity : now - this.deleteFirstTapAt
    if (elapsed >= 0 && elapsed <= 500) {
      this.deleteFirstTapAt = null
      this.deleteTheme()
      return
    }

    this.deleteFirstTapAt = now
    prompt.showToast({ message: "双击删除" })
  },

  async deleteTheme() {
    if (this.deleting) return
    this.deleting = true
    try {
      await removeInstalledTheme(this.themeId, file)
      prompt.showToast({ message: "资源包已删除" })
      router.back()
    } catch (error) {
      this.deleting = false
      const reason = error && error.resourceStorageReason
      const message = reason === "active-theme"
        ? "正在使用的资源包不能删除"
        : reason === "invalid-index"
          ? "资源包索引损坏，删除失败"
          : "删除失败，请稍后重试"
      prompt.showToast({ message })
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.header {
  position: absolute;
  left: 0;
  top: 12px;
  width: 100%;
  height: 77px;
  flex-direction: column;
  align-items: center;
}

.detail-list {
  position: absolute;
  left: 0;
  top: 96px;
  bottom: 0px;
  width: 100%;
  padding-left: 8px;
  padding-right: 8px;
  flex-direction: column;
}

/* Scroll the final card clear of the floating action and rounded screen edge. */
.detail-bottom-spacer {
  width: 100%;
  height: 98px;
  flex-shrink: 0;
}

.detail-card {
  width: 100%;
  min-height: 132px;
  margin-bottom: 8px;
  padding: 16px 12px;
  border-radius: 24px;
  background-color: #262626;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
}

.detail-title {
  width: 100%;
  color: #FFFFFF;
  font-size: 35px;
  font-weight: bold;
  line-height: 40px;
  lines: 1;
}

.detail-value {
  width: 100%;
  margin-top: 3px;
  color: #BBBBBB;
  font-size: 18px;
  line-height: 24px;
}

.status {
  position: absolute;
  left: 16px;
  top: 225px;
  width: 180px;
  color: #BBBBBB;
  font-size: 16px;
  line-height: 23px;
  text-align: center;
  lines: 3;
}

.delete-action-wrap {
  position: absolute;
  left: 0;
  bottom: 10px;
  width: 100%;
  height: 78px;
  align-items: center;
  justify-content: center;
}

.delete-action {
  width: 150px;
  height: 78px;
}

.delete-action-wide {
  display: none;
  width: 324px;
  height: 80px;
}

@media (width: 160) {
  .delete-action-wrap {
    height: 80px;
  }

  .delete-action {
    display: none;
  }

  .delete-action-wide {
    display: flex;
  }

  .header {
    top: 0px;
    height: 60px;
  }

  .detail-list {
    top: 60px;
  }

  .detail-bottom-spacer {
    height: 100px;
  }

  .status {
    left: 0px;
    width: 100%;
  }
}
</style>
