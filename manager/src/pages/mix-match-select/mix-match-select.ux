<import name="time-banner" src="../../components/time"></import>

<template>
  <div class="page" ontouchstart="preserveForUser">
    <div class="header">
      <time-banner title="{{headerTitle}}" clickable="true" onactivate="goBack" />
    </div>

    <text if="{{statusText}}" class="status">{{statusText}}</text>
    <scroll if="{{loaded && rows.length}}" id="choice-list" class="choice-list"
      scroll-y="true" scroll-x="false" bounces="false">
      <div for="{{row in rows}}" tid="choiceId"
        class="choice-row {{row.previewUri ? 'preview-row' : 'compact-row'}}"
        onclick="selectChoice(row.choiceId)">
        <div class="choice-card {{row.previewUri ? 'preview-card' : 'compact-card'}}">
          <div if="{{row.previewUri}}" class="choice-preview-wrap">
            <img class="choice-preview" src="{{row.previewUri}}" />
          </div>
          <div class="choice-footer {{row.previewUri ? 'preview-footer' : 'compact-footer'}}">
            <text class="choice-name">{{row.name}}</text>
            <img class="choice-mark" src="{{row.selected ? '/common/images/true.png' : '/common/images/false.png'}}" />
          </div>
        </div>
      </div>
      <div class="bottom-spacer"></div>
    </scroll>
  </div>
</template>

<script>
import prompt from "@system.prompt"
import router from "@system.router"
import * as file from "../../ts/file"
import { RESOURCE_ORDER_URI, resolveResourceOrder } from "../../ts/resource-order"
import {
  DEFAULT_RESOURCE_CHOICE,
  getResourceCatalog,
  isResourceCatalogCurrent,
  loadResourceOverrides,
  resolveResourceChoice,
  saveResourceOverride,
  validSourcePath,
  SYSTEM_RESOURCE_CHOICE
} from "../../ts/resource-overrides"

export default {
  private: {
    headerTitle: "< 选择来源",
    sourcePath: "",
    rows: [],
    statusText: "正在读取可选资源…",
    loaded: false,
    saving: false,
    selectedChoice: DEFAULT_RESOURCE_CHOICE,
    visible: false,
    loadVersion: 0
  },

  onInit() {
    if (globalThis.themeReceiver) globalThis.themeReceiver.captureLaunchContext()
  },

  preserveForUser() {
    if (globalThis.themeReceiver) globalThis.themeReceiver.preserveForUser()
  },

  onShow() {
    this.visible = true
    this.loadChoices()
  },

  onHide() {
    this.visible = false
    this.loadVersion += 1
  },

  onDestroy() {
    this.visible = false
    this.loadVersion += 1
  },

  async loadChoices() {
    const version = ++this.loadVersion
    if (!this.loaded) this.statusText = "正在读取可选资源…"
    if (!validSourcePath(this.sourcePath)) {
      this.statusText = "替换资源路径无效"
      return
    }
    try {
      const [catalog, overrides, orderText] = await Promise.all([
        getResourceCatalog(file),
        loadResourceOverrides(file),
        file.readOptionalText(RESOURCE_ORDER_URI)
      ])
      if (version !== this.loadVersion || !this.visible) return
      if (!isResourceCatalogCurrent(catalog)) return this.loadChoices()
      const order = resolveResourceOrder(catalog.installedThemeIds, orderText)
      const registration = catalog.byPath.get(this.sourcePath)
      if (!registration) {
        this.rows = []
        this.loaded = false
        this.statusText = "这个路径已没有资源包注册"
        return
      }
      const orderIndex = Object.create(null)
      order.forEach((themeId, index) => { orderIndex[themeId] = index })
      this.selectedChoice = resolveResourceChoice(registration, overrides)
      const options = [
        { choiceId: DEFAULT_RESOURCE_CHOICE, name: "默认", previewUri: "" },
        { choiceId: SYSTEM_RESOURCE_CHOICE, name: "系统", previewUri: "" },
        ...registration.themes.slice().sort((left, right) =>
          (orderIndex[left.themeId] === undefined ? Number.MAX_SAFE_INTEGER : orderIndex[left.themeId]) -
          (orderIndex[right.themeId] === undefined ? Number.MAX_SAFE_INTEGER : orderIndex[right.themeId]))
          .map(theme => ({ choiceId: theme.themeId, name: theme.name, previewUri: theme.previewUri }))
      ]
      this.rows = options.map(option => ({
        choiceId: option.choiceId,
        name: option.name,
        previewUri: option.previewUri,
        selected: option.choiceId === this.selectedChoice
      }))
      this.loaded = true
      this.statusText = ""
    } catch (error) {
      if (version !== this.loadVersion || !this.visible) return
      this.rows = []
      this.loaded = false
      this.statusText = String(error && error.message || "读取可选资源失败")
    }
  },

  async selectChoice(choiceId) {
    if (!this.visible || !this.loaded || this.saving ||
        !this.rows.some(row => row.choiceId === choiceId)) return
    const version = this.loadVersion
    this.saving = true
    try {
      await saveResourceOverride(this.sourcePath, choiceId, file)
      if (version !== this.loadVersion || !this.visible) return
      this.selectedChoice = choiceId
      this.rows.forEach(row => {
        const selected = row.choiceId === choiceId
        if (row.selected !== selected) row.selected = selected
      })
      this.statusText = ""
    } catch (error) {
      if (version !== this.loadVersion || !this.visible) return
      this.statusText = String(error && error.message || "保存选择失败")
      prompt.showToast({ message: "保存选择失败" })
    } finally {
      this.saving = false
    }
  },

  goBack() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.header {
  position: absolute;
  left: 0;
  top: 12px;
  width: 100%;
  height: 77px;
  flex-direction: column;
  align-items: center;
}

.choice-list {
  position: absolute;
  left: 0;
  top: 96px;
  width: 100%;
  height: 372px;
  padding-left: 8px;
  padding-right: 8px;
  flex-direction: column;
}

.choice-row {
  width: 196px;
  flex-shrink: 0;
}

.preview-row {
  height: 168px;
}

.compact-row {
  height: 84px;
}

.choice-card {
  width: 196px;
  margin-bottom: 8px;
  padding-left: 14px;
  padding-right: 13px;
  border-radius: 24px;
  background-color: #262626;
  align-items: center;
}

.preview-card {
  height: 160px;
  flex-direction: column;
}

.compact-card {
  height: 76px;
  flex-direction: row;
  justify-content: space-between;
}

.choice-preview-wrap {
  width: 168px;
  height: 96px;
  align-items: center;
  justify-content: center;
}

.choice-preview {
  width: 96px;
  height: 96px;
  object-fit: contain;
}

.choice-footer {
  width: 168px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.preview-footer {
  height: 56px;
}

.compact-footer {
  height: 76px;
}

.choice-name {
  width: 135px;
  color: #FFFFFF;
  font-size: 35px;
  font-weight: bold;
  line-height: 40px;
  lines: 1;
  text-overflow: ellipsis;
}

.choice-mark {
  width: 32px;
  height: 32px;
}

.status {
  position: absolute;
  left: 14px;
  top: 230px;
  width: 180px;
  color: #BBBBBB;
  font-size: 15px;
  line-height: 21px;
  text-align: center;
  lines: 4;
  text-overflow: ellipsis;
}

.bottom-spacer {
  display: none;
}

/* 212x520 template: use aspect ratio because media-query widths are in dp. */
@media (aspect-ratio: 53/130) {
  .choice-list {
    height: 424px;
  }

  .bottom-spacer {
    display: flex;
    width: 100%;
    height: 52px;
    flex-shrink: 0;
  }
}

@media (width: 160) {
  .header {
    top: 0px;
    height: 60px;
  }

  .choice-list {
    top: 60px;
    height: 408px;
  }

  .choice-row,
  .choice-card,
  .choice-preview-wrap,
  .choice-footer {
    width: 100%;
  }

  .choice-name {
    flex-grow: 1;
    flex-shrink: 1;
  }

  .choice-mark {
    flex-shrink: 0;
    margin-left: 8px;
  }

  .status {
    left: 0px;
    width: 100%;
  }
}
</style>
